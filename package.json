{
  "name": "snake-game",
  "version": "0.3.1",
  "description": "A snake game web component with no dependencies. Add the script, add the tag, play.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "exports": {
    ".": "./src/snake-game.js",
    "./engine": "./src/engine.js",
    "./renderers": "./src/renderers.js",
    "./addons/*": "./addons/*",
    "./skins/*": "./skins/*",
    "./standalone": "./dist/snake-game.js"
  },
  "scripts": {
    "test": "node --test",
    "build": "node scripts/build.js",
    "serve:pages": "node scripts/serve.js --base /snake-game/"
  }
}
